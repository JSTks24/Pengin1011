<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Pengin1011.Modules.FakeBrokenLocale</RootNamespace>
    <AssemblyName>FakeBrokenLocale</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BrokenOutputDir>$(MSBuildThisFileDirectory)..\Pengin1011.Tests\bin\$(Configuration)\$(TargetFramework)\brokenmodule\</BrokenOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Pengin1011.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\zh-CN\Strings.resources" />
  </ItemGroup>

  <Target Name="CopyToBrokenModuleDir" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BrokenOutputDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
