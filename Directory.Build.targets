<Project>

	<PropertyGroup>
		<BridgeGeneratorFolderName>Pengin1011Generator.ModuleBridge.ModuleBridgeGenerator</BridgeGeneratorFolderName>
		<BridgeGeneratedRelativeRoot>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\generated\Pengin1011Generator\$(BridgeGeneratorFolderName)\</BridgeGeneratedRelativeRoot>
		<BridgeManifestFileName>ModuleBridgeManifest.g.cs</BridgeManifestFileName>
	</PropertyGroup>

	<ItemGroup>
		<_BridgeProvider Include="@(BridgeDependency->'..\%(Identity)\%(Identity).csproj')" />
		<ProjectReference Include="@(_BridgeProvider)" Exclude="@(ProjectReference)" ReferenceOutputAssembly="false" />
		<_BridgeProvider Include="@(ProjectReference->WithMetadataValue('BridgeDependency', 'true'))" Exclude="@(_BridgeProvider)" />
		<AdditionalFiles Include="@(_BridgeProvider->'%(RootDir)%(Directory)$(BridgeGeneratedRelativeRoot)$(BridgeManifestFileName)')" />
	</ItemGroup>

	<Target Name="ValidateBridgeManifests" Condition="'@(_BridgeProvider)' != ''" BeforeTargets="CoreCompile">
		<Error Condition="!Exists('%(_BridgeProvider.RootDir)%(_BridgeProvider.Directory)$(BridgeGeneratedRelativeRoot)$(BridgeManifestFileName)')" Text="Bridge manifest missing: dependency module %(_BridgeProvider.Filename) has not been built for configuration $(Configuration)/$(TargetFramework), or its ModuleBridge generator is disabled. Build that dependency module first." />
	</Target>

</Project>
