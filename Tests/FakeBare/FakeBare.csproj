<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Pengin1011.Modules.FakeBare</RootNamespace>
    <AssemblyName>FakeBare</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BareOutputDir>$(MSBuildThisFileDirectory)..\Pengin1011.Tests\bin\$(Configuration)\$(TargetFramework)\baremodule\</BareOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Pengin1011.csproj" />
  </ItemGroup>

  <Target Name="CopyToBareModuleDir" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BareOutputDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
