<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Pengin1011.Modules.FakeBridgeBad</RootNamespace>
    <AssemblyName>FakeBridgeBad</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <BadBridgeOutputDir>$(MSBuildThisFileDirectory)..\Pengin1011.Tests\bin\$(Configuration)\$(TargetFramework)\badbridge\</BadBridgeOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Pengin1011.csproj" />
    <ProjectReference Include="..\..\Generator\Pengin1011Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyToBadBridgeDir" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BadBridgeOutputDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
